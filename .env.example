APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=opentrace
DEBUG=false

# AI migration is opt-in. Use `opentrace migrate --ai-enabled` or set AI_ENABLED=true.
AI_ENABLED=false
AI_PROVIDER=auto
# Set the model IDs required by your selected policy/provider.
# AI_MODEL_SMALL=your-small-model-id
# AI_MODEL_MEDIUM=your-medium-model-id
# AI_MODEL_STRONG=your-strong-model-id
# Provider credentials: OPENAI_API_KEY, GEMINI_API_KEY/GOOGLE_API_KEY, or ANTHROPIC_API_KEY.
# For Ollama, set OLLAMA_HOST (default http://localhost:11434) and model IDs above.
# AI_PROVIDER_ENDPOINT can override the Ollama host.
GENERATION_TIMEOUT_SECONDS=30

